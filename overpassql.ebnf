/* ======================================================================= */
/* Overpass QL EBNF Grammar                                                */
/* ======================================================================= */
/* Notation: W3C EBNF defined in https://www.w3.org/TR/xml/#sec-notation   */
/*                                                                         */
/* Based on https://wiki.openstreetmap.org/wiki/Overpass_API/Overpass_QL,  */
/* verified against the Overpass API source code and implementation        */
/* (v0.7.62.11). Undocumented features accepted by the implementation but  */
/* absent from the wiki are excluded.                                      */
/* ======================================================================= */

/* ----------------------------------------------------------------------- */
/* TOP LEVEL                                                               */
/* ----------------------------------------------------------------------- */

query          ::= ( "[" global_setting "]" ( "[" global_setting "]" )* ";" )?
                   statement*

/* ----------------------------------------------------------------------- */
/* GLOBAL SETTINGS                                                         */
/* ----------------------------------------------------------------------- */

global_setting ::= "timeout" ":" integer
                 | "maxsize" ":" integer
                 | "out" ":" output_format
                 | "bbox" ":" number "," number "," number "," number
                 | "date" ":" datetime_literal
                 | "diff" ":" datetime_literal ( "," datetime_literal )?
                 | "adiff" ":" datetime_literal ( "," datetime_literal )?

output_format  ::= "xml"
                 | "json"
                 | "csv" "(" csv_spec ")"
                 | "custom"
                 | "popup" ( "(" popup_config ")" )*

/* See: https://dev.overpass-api.de/output_formats.html */
popup_config   ::= popup_token ( ";" popup_token )* ";"?
popup_token    ::= ( string_literal | [^;)"'] )*

csv_spec       ::= csv_field ( "," csv_field )*
                   ( ";" boolean_literal ( ";" string_literal )? )?

csv_field            ::= "::" unquoted_csv_builtin
                       | "::" quoted_csv_builtin
                       | tag_key

unquoted_csv_builtin ::= "id" | "type" | "otype" | "lat" | "lon"
                       | "version" | "timestamp" | "changeset"
                       | "uid" | "user" | "count"

quoted_csv_builtin   ::= '"' csv_builtin_name '"'

csv_builtin_name     ::= unquoted_csv_builtin
                       | "count:nodes" | "count:ways"
                       | "count:relations" | "count:areas"

/* ----------------------------------------------------------------------- */
/* STATEMENTS                                                              */
/* ----------------------------------------------------------------------- */

statement      ::= simple_stmt ";"
                 | block_stmt

simple_stmt    ::= query_stmt
                 | union_stmt
                 | item_stmt
                 | out_stmt
                 | recurse_stmt
                 | is_in_stmt
                 | timeline_stmt
                 | local_stmt
                 | convert_stmt
                 | make_stmt
                 | map_to_area_stmt
                 | compare_stmt

block_stmt     ::= foreach_stmt
                 | for_stmt
                 | complete_stmt
                 | if_stmt
                 | retro_stmt

/* ----------------------------------------------------------------------- */
/* QUERY STATEMENT                                                         */
/* ----------------------------------------------------------------------- */

query_stmt     ::= element_type filter* ( "->" set_ref )?

element_type   ::= "node" | "way" | "rel" | "relation"
                 | "nwr" | "nw" | "wr" | "nr"
                 | "area" | "derived"

/* ----------------------------------------------------------------------- */
/* QUERY FILTERS                                                           */
/* ----------------------------------------------------------------------- */

filter         ::= tag_filter
                 | bbox_filter
                 | id_filter
                 | around_set_filter
                 | around_point_filter
                 | around_line_filter
                 | polygon_filter
                 | newer_filter
                 | changed_filter
                 | user_filter
                 | area_set_filter
                 | area_id_filter
                 | recurse_filter
                 | way_count_filter
                 | way_link_filter
                 | set_filter
                 | pivot_filter
                 | if_filter

tag_filter     ::= "[" tag_key "]"
                 | "[" "!" tag_key "]"
                 | "[" tag_key "=" tag_value "]"
                 | "[" tag_key "!=" tag_value "]"
                 | "[" tag_key "~" string_literal ( "," "i" )? "]"
                 | "[" tag_key "!~" string_literal ( "," "i" )? "]"
                 | "[" "~" string_literal "~" string_literal ( "," "i" )? "]"

bbox_filter    ::= "(" number "," number "," number "," number ")"

id_filter      ::= "(" integer ")"
                 | "(" "id" ":" integer ( "," integer )* ")"

around_set_filter   ::= "(" "around" set_ref? ":" unsigned_number ")"
around_point_filter ::= "(" "around" ":" unsigned_number "," number "," number ")"
around_line_filter  ::= "(" "around" ":" unsigned_number
                         "," number "," number
                         "," number "," number
                         ( "," number "," number )* ")"

polygon_filter ::= "(" "poly" ":" poly_string ")"

poly_string    ::= '"' poly_vertex+ '"'
                 | "'" poly_vertex+ "'"

poly_vertex    ::= number number

newer_filter   ::= "(" "newer" ":" datetime_literal ")"

changed_filter ::= "(" "changed" ":" datetime_literal
                   ( "," datetime_literal )? ")"

user_filter    ::= "(" "user" ":" string_literal ( "," string_literal )* ")"
                 | "(" "uid" ":" integer ( "," integer )* ")"
                 | "(" "user_touched" ":" string_literal ( "," string_literal )* ")"
                 | "(" "uid_touched" ":" integer ( "," integer )* ")"

area_set_filter ::= "(" "area" set_ref? ")"

area_id_filter  ::= "(" "area" ":" integer ")"

recurse_filter ::= "(" recurse_type set_ref? ( ":" string_literal )? ")"

recurse_type   ::= "w" | "r" | "bn" | "bw" | "br"

way_count_filter ::= "(" "way_cnt" ":" int_range ")"

way_link_filter  ::= "(" "way_link" ":" int_range ")"

int_range      ::= integer ( "-" integer? )?

set_filter     ::= "." set_name

pivot_filter   ::= "(" "pivot" set_ref? ")"

if_filter      ::= "(" "if" ":" evaluator ")"

/* ----------------------------------------------------------------------- */
/* BLOCK STATEMENTS                                                        */
/* ----------------------------------------------------------------------- */

block_body     ::= "{" statement* "}"
                 | "(" statement* ")"

foreach_stmt   ::= "foreach" set_ref? ( "->" set_ref )?
                   block_body

for_stmt       ::= "for" set_ref? ( "->" set_ref )?
                   "(" evaluator ")"
                   block_body

complete_stmt  ::= "complete" set_ref? ( "->" set_ref )?
                   ( "(" integer ")" )?
                   "{" statement* "}"

if_stmt        ::= "if" "(" evaluator ")"
                   block_body
                   ( "else" block_body )?

retro_stmt     ::= "retro" "(" evaluator ")"
                   block_body

/* ----------------------------------------------------------------------- */
/* OTHER STATEMENTS                                                        */
/* ----------------------------------------------------------------------- */

union_stmt     ::= "(" union_body ")" ( "->" set_ref )?

union_body     ::= union_member*

union_member   ::= statement
                 | "-" statement

item_stmt      ::= set_ref ( "->" set_ref )?

/* out_token may appear in any order; integer and bbox_filter at most
   once each */
out_stmt       ::= set_ref? "out" out_token*

out_token      ::= out_option | integer | bbox_filter

out_option     ::= "ids" | "skel" | "body" | "tags" | "meta" | "count"
                 | "geom" | "bb" | "center"
                 | "noids"
                 | "asc" | "qt"

recurse_stmt   ::= set_ref? ( "<" | "<<" | ">" | ">>" )
                   ( "->" set_ref )?

is_in_stmt     ::= set_ref? "is_in"
                   ( "(" number "," number ")" )?
                   ( "->" set_ref )?

timeline_stmt  ::= "timeline" "(" timeline_type "," integer
                   ( "," integer )? ")" ( "->" set_ref )?

timeline_type  ::= "node" | "way" | "relation"

local_stmt     ::= set_ref? "local" ( "l" | "ll" | "llb" )?
                   ( "->" set_ref )?

convert_stmt   ::= set_ref? "convert" derived_type
                   ( convert_tag_assignment ( "," convert_tag_assignment )* )?
                   ( "->" set_ref )?

make_stmt      ::= "make" derived_type
                   ( make_tag_assignment ( "," make_tag_assignment )* )?
                   ( "->" set_ref )?

convert_tag_assignment ::= make_tag_assignment
                         | "::" "=" evaluator

make_tag_assignment ::= "!" tag_key
                      | "::id" "=" evaluator
                      | "::geom" "=" evaluator
                      | set_name "::" "=" evaluator
                      | tag_key "=" evaluator

map_to_area_stmt ::= set_ref? "map_to_area" ( "->" set_ref )?

compare_stmt   ::= set_ref? "compare"
                   "(" ( "delta" ":" evaluator )? ")"
                   ( "->" set_ref )?
                   ( "{" statement* "}" )?

/* ----------------------------------------------------------------------- */
/* EVALUATORS                                                              */
/* ----------------------------------------------------------------------- */

evaluator      ::= ternary_expr

ternary_expr   ::= or_expr ( "?" or_expr ":" ternary_expr )?

or_expr        ::= and_expr ( "||" and_expr )*

and_expr       ::= not_expr ( "&&" not_expr )*

not_expr       ::= "!" not_expr
                 | compare_expr

compare_expr   ::= add_expr
                   ( ( "==" | "!=" | "<" | "<=" | ">" | ">=" ) add_expr )?

add_expr       ::= mul_expr ( ( "+" | "-" ) mul_expr )*

mul_expr       ::= unary_expr ( ( "*" | "/" ) unary_expr )*

unary_expr     ::= "-" unary_expr
                 | primary_expr

primary_expr   ::= "(" evaluator ")"
                 | number_literal
                 | string_literal
                 | "id" "(" ")"
                 | "type" "(" ")"
                 | "t" "[" evaluator "]"
                 | "is_tag" "(" tag_key ")"
                 | "keys" "(" ")"
                 | "::" /* only valid as the value of a generic property assignment in convert/make */
                 | "version" "(" ")"
                 | "timestamp" "(" ")"
                 | "changeset" "(" ")"
                 | "uid" "(" ")"
                 | "user" "(" ")"
                 | "count_tags" "(" ")"
                 | "count_members" "(" ")"
                 | "count_distinct_members" "(" ")"
                 | "count_by_role" "(" evaluator ")"
                 | "count_distinct_by_role" "(" evaluator ")"
                 | "is_closed" "(" ")"
                 | "lat" "(" ")"
                 | "lon" "(" ")"
                 | "geom" "(" ")"
                 | "length" "(" ")"
                 | "center" "(" evaluator ")"
                 | "trace" "(" evaluator ")"
                 | "hull" "(" evaluator ")"
                 | "pt" "(" evaluator "," evaluator ")"
                 | "lstr" "(" evaluator "," evaluator ( "," evaluator )* ")"
                 | "poly" "(" evaluator "," evaluator ( "," evaluator )* ")"
                 | "per_member" "(" evaluator ")"
                 | "per_vertex" "(" evaluator ")"
                 | "pos" "(" ")"   /* only valid inside per_member or per_vertex */
                 | "mtype" "(" ")" /* only valid inside per_member or per_vertex */
                 | "ref" "(" ")"   /* only valid inside per_member or per_vertex */
                 | "role" "(" ")"  /* only valid inside per_member or per_vertex */
                 | "angle" "(" ")" /* only valid inside per_member or per_vertex */
                 | "number" "(" evaluator ")"
                 | "date" "(" evaluator ")"
                 | "suffix" "(" evaluator ")"
                 | "abs" "(" evaluator ")"
                 | "is_number" "(" evaluator ")"
                 | "is_date" "(" evaluator ")"
                 | ( set_name "." )? "u" "(" evaluator ")"
                 | ( set_name "." )? "min" "(" evaluator ")"
                 | ( set_name "." )? "max" "(" evaluator ")"
                 | ( set_name "." )? "sum" "(" evaluator ")"
                 | ( set_name "." )? "set" "(" evaluator ")"
                 | ( set_name "." )? "gcat" "(" evaluator ")"
                 | ( set_name "." )? "count" "(" count_type ")"
                 | "lrs_in" "(" evaluator "," evaluator ")"
                 | "lrs_isect" "(" evaluator "," evaluator ")"
                 | "lrs_union" "(" evaluator "," evaluator ")"
                 | "lrs_min" "(" evaluator ")"
                 | "lrs_max" "(" evaluator ")"
                 | set_name "." "val"

/* ----------------------------------------------------------------------- */
/* SET REFERENCES                                                          */
/* ----------------------------------------------------------------------- */

set_ref        ::= "." set_name

set_name       ::= "_"
                 | set_id

count_type     ::= "nodes" | "ways" | "relations" | "deriveds"
                 | "nwr" | "nw" | "wr" | "nr"

/* ----------------------------------------------------------------------- */
/* LEXICAL TOKENS                                                          */
/* ----------------------------------------------------------------------- */

set_id         ::= set_id_start set_id_cont*
set_id_start   ::= [A-Za-z_]
set_id_cont    ::= [A-Za-z0-9_]

derived_type      ::= derived_type_start derived_type_cont*
derived_type_start ::= [A-Za-z]
derived_type_cont  ::= [A-Za-z0-9_]

tag_key        ::= string_literal
                 | unquoted_key

unquoted_key   ::= key_start key_cont*
key_start      ::= [A-Za-z_]
key_cont       ::= [A-Za-z0-9_]

tag_value      ::= string_literal
                 | unquoted_value

unquoted_value ::= value_char+
value_char     ::= [A-Za-z0-9_]

string_literal ::= dquoted_string
                 | squoted_string

dquoted_string ::= '"' dquote_char* '"'
dquote_char    ::= [^"#x5C] | escape_seq

squoted_string ::= "'" squote_char* "'"
squote_char    ::= [^'#x5C] | escape_seq

escape_seq     ::= "\\" ( "n" | "t" | '"' | "'" | "\\" )
                 | "\\u" hex_digit hex_digit hex_digit hex_digit

hex_digit      ::= [0-9A-Fa-f]

boolean_literal ::= "true" | "false"

integer        ::= digit+

number         ::= "-"? unsigned_number

unsigned_number ::= digit+ ( "." digit* )? ( "e" ( "+" | "-" )? digit+ )?
                  | "." digit+ ( "e" ( "+" | "-" )? digit+ )?

number_literal ::= unsigned_number

digit          ::= [0-9]

datetime_literal ::= '"' date_digits "T" time_digits "Z" '"'
                   | "'" date_digits "T" time_digits "Z" "'"

date_digits    ::= digit digit digit digit "-" digit digit "-" digit digit

time_digits    ::= digit digit ":" digit digit ":" digit digit

/* ----------------------------------------------------------------------- */
/* IGNORED TOKENS (whitespace and comments)                                */
/* ----------------------------------------------------------------------- */

whitespace     ::= [#x20#x9#xA#xD]+

line_comment   ::= "//" [^#xA]*

block_comment  ::= "/*" block_comment_body "*/"
block_comment_body ::= ( [^*] | "*" [^/] )*
